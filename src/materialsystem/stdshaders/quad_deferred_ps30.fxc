// STATIC:		"STAGE"					"0..1"
// STATIC:		"NORMAL_MODE"			"0..1"
// STATIC:		"ALPHATEST"				"0..1"
// STATIC:		"VERTEXCOLOR"			"0..1"

#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"
#include "common_dither_fxc.h"

sampler sAlbedo							: register( s0 );

#if ( ALPHATEST )
const float g_flAlphaRef				: register( c0 );
#endif

#if ( STAGE == 1 )
sampler sLightAccum						: register( s2 );
const float4 g_vecFullScreenTexel		: register( c1 );
#endif

struct PS_INPUT
{
	float2 vTexCoord				: TEXCOORD0;
	float4 worldNormal_Depth		: TEXCOORD1;
	float4 vColor_0					: COLOR0;
	float2 vScreenPos				: VPOS;
};

struct PS_OUTPUT
{
	float4 vColor_0					: COLOR0;
#if ( STAGE == 0 )
	float4 vColor_1					: COLOR1;
#endif
};

PS_OUTPUT main( const PS_INPUT In )
{
	PS_OUTPUT Out;

#if ( STAGE == 0 )
	// GBUFFER PASS:
#if ( ALPHATEST )
	float4 flAlbedoSample = tex2D( sAlbedo, In.vTexCoord );
	clip( flAlbedoSample.a - g_flAlphaRef );
	ScreenDoorDitherClip( In.vColor_0.a, In.vScreenPos.xy );
#endif

	// Map normal [-1, 1] -> [0, 1]
	float3 worldNormal = In.worldNormal_Depth.xyz * 0.5f + 0.5f;

#if ( NORMAL_MODE == 0 )
	// Foliage: phong_exp = 0, half_lambert = 1, litface = 1
	float flLightingCtrl = PackLightingControls( 0, 1, 1 );
#else
	// Cable: phong_exp = 16, half_lambert = 0, litface = 0
	float flLightingCtrl = PackLightingControls( 16, 0, 0 );
#endif

	Out.vColor_0 = float4( worldNormal, flLightingCtrl );
	Out.vColor_1 = float4( In.worldNormal_Depth.w, 0.0f, 0.0f, 1.0f );
#else
	// COMPOSITION PASS:
	float4 flAlbedoSample = tex2D( sAlbedo, In.vTexCoord );

#if ( ALPHATEST )
	clip( flAlbedoSample.a - g_flAlphaRef );
	ScreenDoorDitherClip( In.vColor_0.a, In.vScreenPos.xy );
#endif

	float2 screenPos = ( In.vScreenPos + 0.5f ) * g_vecFullScreenTexel.xy;
	float4 flLighting = ReadLighting( tex2D( sLightAccum, screenPos ) );

	float3 flDiffuse = flAlbedoSample.rgb * flLighting.rgb;

#if ( VERTEXCOLOR )
	flDiffuse *= In.vColor_0.rgb;
#endif

	Out.vColor_0 = float4( flDiffuse * LINEAR_LIGHT_SCALE, 1.0f );
#endif

	return Out;
}

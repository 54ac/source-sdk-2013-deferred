{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-ninja",
      "hidden": true,
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "PATH": "$penv{PATH};$penv{VSINSTALLDIR}/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_LINKER": "link",
        "CMAKE_AR": "lib",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "USE_LLD": "ON"
      }
    },
    {
      "name": "hl2mp-debug",
      "displayName": "HL2MP (Debug)",
      "description": "Half-Life 2: Deathmatch Debug build",
      "inherits": "base-ninja",
      "cacheVariables": {
        "GAME": "hl2mp",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "hl2mp-release",
      "displayName": "HL2MP (Release)",
      "description": "Half-Life 2: Deathmatch Release build",
      "inherits": "base-ninja",
      "cacheVariables": {
        "GAME": "hl2mp",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "hl2-debug",
      "displayName": "HL2 (Debug)",
      "description": "Half-Life 2 Singleplayer Debug build",
      "inherits": "base-ninja",
      "cacheVariables": {
        "GAME": "hl2",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "hl2-release",
      "displayName": "HL2 (Release)",
      "description": "Half-Life 2 Singleplayer Release build",
      "inherits": "base-ninja",
      "cacheVariables": {
        "GAME": "hl2",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "episodic-debug",
      "displayName": "Episodic (Debug)",
      "description": "Half-Life 2: Episodes Debug build",
      "inherits": "base-ninja",
      "cacheVariables": {
        "GAME": "episodic",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "episodic-release",
      "displayName": "Episodic (Release)",
      "description": "Half-Life 2: Episodes Release build",
      "inherits": "base-ninja",
      "cacheVariables": {
        "GAME": "episodic",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "tf-debug",
      "displayName": "Team Fortress 2 (Debug)",
      "description": "Team Fortress 2 Debug build",
      "inherits": "base-ninja",
      "cacheVariables": {
        "GAME": "tf",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "tf-release",
      "displayName": "Team Fortress 2 (Release)",
      "description": "Team Fortress 2 Release build",
      "inherits": "base-ninja",
      "cacheVariables": {
        "GAME": "tf",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "hl2mp-debug",
      "configurePreset": "hl2mp-debug"
    },
    {
      "name": "hl2mp-release",
      "configurePreset": "hl2mp-release"
    },
    {
      "name": "hl2-debug",
      "configurePreset": "hl2-debug"
    },
    {
      "name": "hl2-release",
      "configurePreset": "hl2-release"
    },
    {
      "name": "episodic-debug",
      "configurePreset": "episodic-debug"
    },
    {
      "name": "episodic-release",
      "configurePreset": "episodic-release"
    },
    {
      "name": "tf-debug",
      "configurePreset": "tf-debug"
    },
    {
      "name": "tf-release",
      "configurePreset": "tf-release"
    }
  ]
}

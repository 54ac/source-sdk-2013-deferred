{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (hl2mp-debug)",
      "type": "cmake",
      "command": "build",
      "preset": "hl2mp-debug",
      "targets": [
        "client",
        "server",
        "game_shader_dx9"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build (hl2mp-release)",
      "type": "cmake",
      "command": "build",
      "preset": "hl2mp-release",
      "targets": [
        "client",
        "server",
        "game_shader_dx9"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Compile Shaders",
      "type": "cmake",
      "command": "build",
      "preset": "hl2mp-release",
      "targets": [
        "deferred_shaders"
      ],
      "problemMatcher": []
    },
    {
      "label": "Clean Shaders",
      "type": "cmake",
      "command": "build",
      "preset": "hl2mp-release",
      "targets": [
        "clean_shaders"
      ],
      "problemMatcher": []
    }
  ]
}

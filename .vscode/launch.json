{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Compile + Run",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "Build (hl2mp-release)",
      "program": "${workspaceFolder}/game/mod_hl2mp_win64.exe",
      "args": [
        "-game",
        "mod_hl2mp",
        "-windowed",
        "-novid",
        "-dev",
        "-allowdebug"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/game",
      "environment": [],
      "console": "externalTerminal"
    },
    {
      "name": "Run",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/game/mod_hl2mp_win64.exe",
      "args": [
        "-game",
        "mod_hl2mp",
        "-windowed",
        "-novid",
        "-dev",
        "-allowdebug"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/game",
      "environment": [],
      "console": "externalTerminal"
    }
  ]
}
